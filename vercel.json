{
  "services": {
    "nova-copilot": {
      "root": ".",
      "buildCommand": "pip install -r requirements.txt",
      "entrypoint": "index.py"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "nova-copilot"
      }
    }
  ]
}
